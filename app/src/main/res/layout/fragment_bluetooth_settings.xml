<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".BluetoothSettingsFragment">

    <TextView
        android:id="@+id/bt_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Bluetooth Device Settings"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/device_name_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:text="Device Name to Scan For"
        android:textAlignment="center"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_settings_title" />

    <EditText
        android:id="@+id/edit_text_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="e.g., MyESP32"
        android:inputType="text"
        android:textAlignment="center"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="@+id/device_name_label"
        app:layout_constraintStart_toStartOf="@+id/device_name_label"
        app:layout_constraintTop_toBottomOf="@+id/device_name_label" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_discover_devices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Enable Device Discovery"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/edit_text_device_name"
        app:layout_constraintStart_toStartOf="@+id/edit_text_device_name"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_device_name" />

    <TextView
        android:id="@+id/discover_switch_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enable this to scan for new devices. This will turn off automatically after successful provisioning."
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/switch_discover_devices"
        app:layout_constraintStart_toStartOf="@+id/switch_discover_devices"
        app:layout_constraintTop_toBottomOf="@+id/switch_discover_devices" />

</androidx.constraintlayout.widget.ConstraintLayout>