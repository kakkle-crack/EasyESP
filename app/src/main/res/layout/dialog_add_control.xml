<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add New Control"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Control Name Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Control Name (e.g., Main LED)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialog_control_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Pin Number Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="GPIO Pin Number">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialog_control_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Control Type Spinner (Dropdown) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Control Type"
        android:textSize="12sp"/>
    <Spinner
        android:id="@+id/dialog_control_type_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Value Input (for Button Duration or Slider Value) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dialog_value_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:hint="Value">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialog_control_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dialog_command_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialog_control_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Command to Send"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>