<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.EasyESP" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purple_200</item>
        <item name="colorOnPrimaryContainer">@color/purple_700</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Background colors -->
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">#F2F0F4</item>
        <item name="colorOnSurfaceVariant">#49454F</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/purple_700</item>

        <!-- TextInputLayout Styles -->
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>

        <!-- NavigationView Styles -->
        <item name="navigationViewStyle">@style/Widget.EasyESP.NavigationView</item>
    </style>

    <style name="Widget.EasyESP.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemTextColor">@color/white</item>
        <item name="itemIconTint">@color/white</item>
        <item name="itemTextAppearance">@style/TextAppearance.EasyESP.NavMenu</item>
    </style>

    <style name="TextAppearance.EasyESP.NavMenu" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Specific theme for dialogs to ensure readability -->
    <style name="Theme.EasyESP.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="colorSurface">@color/purple_700</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorOutline">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.EasyESP.Button.Text</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.EasyESP.Button.Text</item>
    </style>

    <style name="Widget.EasyESP.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/white</item>
    </style>

</resources>
